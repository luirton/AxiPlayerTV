{
  "expo": {
    "name": "Axi Player TV",
    "slug": "axi-player-tv",
    "version": "1.0.0",
    "scheme": "axiplayertv",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#070A12",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.axiplayertv.app",
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_NETWORK_STATE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070A12",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "./plugins/withCleartextTraffic",
      "./plugins/withAndroidTV",
      "expo-router",
      "expo-image",
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "light"
      },
      "eas": {
        "projectId": "2eacb59e-51b4-44fd-bdfd-19dcd2d4da4d"
      }
    },
    "owner": "luirton"
  }
}
